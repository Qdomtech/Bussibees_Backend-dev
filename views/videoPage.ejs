<!DOCTYPE html>
<html>
<head>
  <title><%= video.title %></title>
  <style>
    .video-container {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
    }
    .video-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
  </style>
</head>
<body>
  <h2><%= video.title %></h2>
  <div class="video-container">
    <%- video.embedUrl %> 
  </div>
</body>
</html>
